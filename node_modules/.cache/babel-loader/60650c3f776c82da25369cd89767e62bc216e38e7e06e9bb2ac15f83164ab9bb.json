{"ast":null,"code":"import { guardarFachada, actualizarFachada, borrarPorIdFachada } from '../Clients/ClienteClient';\nexport default {\n  data() {\n    return {\n      cliente: {\n        id: '',\n        cedula: '',\n        nombre: '',\n        apellido: '',\n        razonSocial: '',\n        direccion: '',\n        telefono: '',\n        email: ''\n      },\n      mensaje: '',\n      mensajeColor: 'green'\n    };\n  },\n  methods: {\n    async guardar() {\n      try {\n        if (!this.cliente.cedula || !this.cliente.nombre || !this.cliente.apellido) {\n          this.mensaje = 'Completa los campos obligatorios para guardar.';\n          this.mensajeColor = 'red';\n          return;\n        }\n        const clienteToBody = {\n          cedula: this.cliente.cedula,\n          nombre: this.cliente.nombre,\n          apellido: this.cliente.apellido,\n          razonSocial: this.cliente.razonSocial,\n          direccion: this.cliente.direccion,\n          telefono: this.cliente.telefono,\n          email: this.cliente.email\n        };\n        await guardarFachada(clienteToBody);\n        this.mensaje = 'Cliente guardado correctamente.';\n        this.mensajeColor = 'green';\n      } catch (e) {\n        this.mensaje = 'Error al guardar: ' + (e.response?.data || e.message);\n        this.mensajeColor = 'red';\n      }\n    },\n    async actualizar() {\n      try {\n        if (!this.cliente.id) {\n          this.mensaje = 'Ingresa el ID para actualizar.';\n          this.mensajeColor = 'red';\n          return;\n        }\n        const clienteToBody = {\n          cedula: this.cliente.cedula,\n          nombre: this.cliente.nombre,\n          apellido: this.cliente.apellido,\n          razonSocial: this.cliente.razonSocial,\n          direccion: this.cliente.direccion,\n          telefono: this.cliente.telefono,\n          email: this.cliente.email\n        };\n        await actualizarFachada(this.cliente.id, clienteToBody);\n        this.mensaje = 'Cliente actualizado correctamente.';\n        this.mensajeColor = 'green';\n      } catch (e) {\n        this.mensaje = 'Error al actualizar: ' + (e.response?.data || e.message);\n        this.mensajeColor = 'red';\n      }\n    },\n    async borrar() {\n      try {\n        if (!this.cliente.id) {\n          this.mensaje = 'Ingresa el ID para borrar.';\n          this.mensajeColor = 'red';\n          return;\n        }\n        await borrarPorIdFachada(this.cliente.id);\n        this.mensaje = 'Cliente borrado correctamente.';\n        this.mensajeColor = 'green';\n      } catch (e) {\n        this.mensaje = 'Error al borrar: ' + (e.response?.data || e.message);\n        this.mensajeColor = 'red';\n      }\n    }\n  }\n};","map":{"version":3,"names":["guardarFachada","actualizarFachada","borrarPorIdFachada","data","cliente","id","cedula","nombre","apellido","razonSocial","direccion","telefono","email","mensaje","mensajeColor","methods","guardar","clienteToBody","e","response","message","actualizar","borrar"],"sources":["C:\\Users\\mdllumiquingat\\Documents\\Programacion\\final_web\\src\\components\\Cliente.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Gestión de Clientes</h2>\r\n    <div>\r\n      <input v-model=\"cliente.id\" type=\"number\" placeholder=\"ID (para actualizar/borrar)\" />\r\n      <input v-model=\"cliente.cedula\" type=\"text\" placeholder=\"Cédula\" />\r\n      <input v-model=\"cliente.nombre\" type=\"text\" placeholder=\"Nombre\" />\r\n      <input v-model=\"cliente.apellido\" type=\"text\" placeholder=\"Apellido\" />\r\n      <input v-model=\"cliente.razonSocial\" type=\"text\" placeholder=\"Razón Social\" />\r\n      <input v-model=\"cliente.direccion\" type=\"text\" placeholder=\"Dirección\" />\r\n      <input v-model=\"cliente.telefono\" type=\"text\" placeholder=\"Teléfono\" />\r\n      <input v-model=\"cliente.email\" type=\"email\" placeholder=\"Correo electrónico\" />\r\n    </div>\r\n    <button @click=\"guardar\">Guardar</button>\r\n    <button @click=\"actualizar\">Actualizar</button>\r\n    <button @click=\"borrar\">Borrar</button>\r\n    <div v-if=\"mensaje\" :style=\"{color: mensajeColor, marginTop: '10px'}\">{{ mensaje }}</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nimport { guardarFachada, actualizarFachada, borrarPorIdFachada } from '../Clients/ClienteClient';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      cliente: {\r\n        id: '',\r\n        cedula: '',\r\n        nombre: '',\r\n        apellido: '',\r\n        razonSocial: '',\r\n        direccion: '',\r\n        telefono: '',\r\n        email: '',\r\n      },\r\n      mensaje: '',\r\n      mensajeColor: 'green',\r\n    };\r\n  },\r\n  methods: {\r\n    async guardar() {\r\n      try {\r\n        if (!this.cliente.cedula || !this.cliente.nombre || !this.cliente.apellido) {\r\n          this.mensaje = 'Completa los campos obligatorios para guardar.';\r\n          this.mensajeColor = 'red';\r\n          return;\r\n        }\r\n        const clienteToBody = {\r\n          cedula: this.cliente.cedula,\r\n          nombre: this.cliente.nombre,\r\n          apellido: this.cliente.apellido,\r\n          razonSocial: this.cliente.razonSocial,\r\n          direccion: this.cliente.direccion,\r\n          telefono: this.cliente.telefono,\r\n          email: this.cliente.email,\r\n        };\r\n        await guardarFachada(clienteToBody);\r\n        this.mensaje = 'Cliente guardado correctamente.';\r\n        this.mensajeColor = 'green';\r\n      } catch (e) {\r\n        this.mensaje = 'Error al guardar: ' + (e.response?.data || e.message);\r\n        this.mensajeColor = 'red';\r\n      }\r\n    },\r\n    async actualizar() {\r\n      try {\r\n        if (!this.cliente.id) {\r\n          this.mensaje = 'Ingresa el ID para actualizar.';\r\n          this.mensajeColor = 'red';\r\n          return;\r\n        }\r\n        const clienteToBody = {\r\n          cedula: this.cliente.cedula,\r\n          nombre: this.cliente.nombre,\r\n          apellido: this.cliente.apellido,\r\n          razonSocial: this.cliente.razonSocial,\r\n          direccion: this.cliente.direccion,\r\n          telefono: this.cliente.telefono,\r\n          email: this.cliente.email,\r\n        };\r\n        await actualizarFachada(this.cliente.id, clienteToBody);\r\n        this.mensaje = 'Cliente actualizado correctamente.';\r\n        this.mensajeColor = 'green';\r\n      } catch (e) {\r\n        this.mensaje = 'Error al actualizar: ' + (e.response?.data || e.message);\r\n        this.mensajeColor = 'red';\r\n      }\r\n    },\r\n    async borrar() {\r\n      try {\r\n        if (!this.cliente.id) {\r\n          this.mensaje = 'Ingresa el ID para borrar.';\r\n          this.mensajeColor = 'red';\r\n          return;\r\n        }\r\n        await borrarPorIdFachada(this.cliente.id);\r\n        this.mensaje = 'Cliente borrado correctamente.';\r\n        this.mensajeColor = 'green';\r\n      } catch (e) {\r\n        this.mensaje = 'Error al borrar: ' + (e.response?.data || e.message);\r\n        this.mensajeColor = 'red';\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scpoped>\r\nh2 {\r\n  color: #0d47a1;\r\n  margin-bottom: 18px;\r\n  text-align: center;\r\n}\r\ndiv {\r\n  background: #fff;\r\n  border-radius: 16px;\r\n  box-shadow: 0 4px 24px rgba(13,71,161,0.08);\r\n  padding: 32px 36px;\r\n  margin: 32px auto;\r\n  max-width: 480px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\ninput {\r\n  display: block;\r\n  width: 340px;\r\n  margin-bottom: 18px;\r\n  padding: 12px 14px;\r\n  border: 1.5px solid #b0bec5;\r\n  border-radius: 8px;\r\n  font-size: 1.05rem;\r\n  background: #f9fafb;\r\n  transition: border 0.2s;\r\n  outline: none;\r\n}\r\ninput:focus {\r\n  border: 2px solid #42b983;\r\n  background: #e3f2fd;\r\n}\r\nbutton {\r\n  background: linear-gradient(90deg, #42b983 0%, #0d47a1 100%);\r\n  color: #fff;\r\n  border: none;\r\n  border-radius: 8px;\r\n  padding: 12px 28px;\r\n  margin: 10px 8px 0 0;\r\n  font-size: 1.08rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: background 0.2s, box-shadow 0.2s;\r\n  box-shadow: 0 2px 8px rgba(66,185,131,0.10);\r\n}\r\nbutton:hover {\r\n  background: linear-gradient(90deg, #0d47a1 0%, #42b983 100%);\r\n  box-shadow: 0 4px 16px rgba(13,71,161,0.13);\r\n}\r\n</style>\r\n\r\n<style>\r\n/* Puedes agregar estilos aquí */\r\n</style>"],"mappings":"AAsBA,SAASA,cAAc,EAAEC,iBAAiB,EAAEC,kBAAiB,QAAS,0BAA0B;AAEhG,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;QACPC,EAAE,EAAE,EAAE;QACNC,MAAM,EAAE,EAAE;QACVC,MAAM,EAAE,EAAE;QACVC,QAAQ,EAAE,EAAE;QACZC,WAAW,EAAE,EAAE;QACfC,SAAS,EAAE,EAAE;QACbC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE;MACT,CAAC;MACDC,OAAO,EAAE,EAAE;MACXC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,OAAOA,CAAA,EAAG;MACd,IAAI;QACF,IAAI,CAAC,IAAI,CAACZ,OAAO,CAACE,MAAK,IAAK,CAAC,IAAI,CAACF,OAAO,CAACG,MAAK,IAAK,CAAC,IAAI,CAACH,OAAO,CAACI,QAAQ,EAAE;UAC1E,IAAI,CAACK,OAAM,GAAI,gDAAgD;UAC/D,IAAI,CAACC,YAAW,GAAI,KAAK;UACzB;QACF;QACA,MAAMG,aAAY,GAAI;UACpBX,MAAM,EAAE,IAAI,CAACF,OAAO,CAACE,MAAM;UAC3BC,MAAM,EAAE,IAAI,CAACH,OAAO,CAACG,MAAM;UAC3BC,QAAQ,EAAE,IAAI,CAACJ,OAAO,CAACI,QAAQ;UAC/BC,WAAW,EAAE,IAAI,CAACL,OAAO,CAACK,WAAW;UACrCC,SAAS,EAAE,IAAI,CAACN,OAAO,CAACM,SAAS;UACjCC,QAAQ,EAAE,IAAI,CAACP,OAAO,CAACO,QAAQ;UAC/BC,KAAK,EAAE,IAAI,CAACR,OAAO,CAACQ;QACtB,CAAC;QACD,MAAMZ,cAAc,CAACiB,aAAa,CAAC;QACnC,IAAI,CAACJ,OAAM,GAAI,iCAAiC;QAChD,IAAI,CAACC,YAAW,GAAI,OAAO;MAC7B,EAAE,OAAOI,CAAC,EAAE;QACV,IAAI,CAACL,OAAM,GAAI,oBAAmB,IAAKK,CAAC,CAACC,QAAQ,EAAEhB,IAAG,IAAKe,CAAC,CAACE,OAAO,CAAC;QACrE,IAAI,CAACN,YAAW,GAAI,KAAK;MAC3B;IACF,CAAC;IACD,MAAMO,UAAUA,CAAA,EAAG;MACjB,IAAI;QACF,IAAI,CAAC,IAAI,CAACjB,OAAO,CAACC,EAAE,EAAE;UACpB,IAAI,CAACQ,OAAM,GAAI,gCAAgC;UAC/C,IAAI,CAACC,YAAW,GAAI,KAAK;UACzB;QACF;QACA,MAAMG,aAAY,GAAI;UACpBX,MAAM,EAAE,IAAI,CAACF,OAAO,CAACE,MAAM;UAC3BC,MAAM,EAAE,IAAI,CAACH,OAAO,CAACG,MAAM;UAC3BC,QAAQ,EAAE,IAAI,CAACJ,OAAO,CAACI,QAAQ;UAC/BC,WAAW,EAAE,IAAI,CAACL,OA