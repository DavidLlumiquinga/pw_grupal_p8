{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\n// Importa aquí tu función para consultar facturas\nimport { consultarFacturas, consultarFacturasConClientes } from '../Clients/ReporteFacturaClient';\nexport default {\n  data() {\n    return {\n      facturas: [],\n      facturasConClientes: [],\n      mostrarClientes: false,\n      cargando: false,\n      mensaje: '',\n      mensajeColor: 'green'\n    };\n  },\n  methods: {\n    async consultarBasico() {\n      try {\n        console.log('Iniciando consulta básica de facturas...');\n        this.cargando = true;\n        this.mostrarClientes = false;\n        this.mensaje = 'Cargando facturas...';\n        this.mensajeColor = 'blue';\n        const data = await consultarFacturas();\n        console.log('Datos recibidos en consultarBasico:', data);\n        this.facturas = data || [];\n        this.facturasConClientes = [];\n        if (this.facturas.length === 0) {\n          this.mensaje = 'No se encontraron facturas';\n          this.mensajeColor = 'orange';\n        } else {\n          this.mensaje = `Se encontraron ${this.facturas.length} facturas`;\n          this.mensajeColor = 'green';\n        }\n      } catch (e) {\n        console.error('Error en consultarBasico:', e);\n        this.mensaje = 'Error al consultar facturas: ' + (e.response?.data?.message || e.message || 'Error desconocido');\n        this.mensajeColor = 'red';\n        this.facturas = [];\n      } finally {\n        this.cargando = false;\n      }\n    },\n    async consultarConClientes() {\n      try {\n        console.log('Iniciando consulta con clientes...');\n        this.cargando = true;\n        this.mostrarClientes = true;\n        this.mensaje = 'Cargando información de clientes...';\n        this.mensajeColor = 'blue';\n        const data = await consultarFacturasConClientes();\n        console.log('Datos recibidos en consultarConClientes:', data);\n        this.facturasConClientes = data || [];\n        this.facturas = [];\n        if (this.facturasConClientes.length === 0) {\n          this.mensaje = 'No se encontraron facturas con datos de clientes';\n          this.mensajeColor = 'orange';\n        } else {\n          const clientesEncontrados = this.facturasConClientes.filter(f => f.clienteCompleto).length;\n          this.mensaje = `Se encontraron ${this.facturasConClientes.length} facturas (${clientesEncontrados} con datos de cliente)`;\n          this.mensajeColor = 'green';\n        }\n      } catch (e) {\n        this.mensaje = 'Error al consultar facturas con clientes: ' + (e.response?.data || e.message);\n        this.mensajeColor = 'red';\n        this.mostrarClientes = false;\n      } finally {\n        this.cargando = false;\n      }\n    },\n    formatearGenero(genero) {\n      const generos = {\n        'masculino': 'Masculino',\n        'femenino': 'Femenino',\n        'otro': 'Otro',\n        'no_especifica': 'No especifica'\n      };\n      return generos[genero] || 'N/A';\n    }\n  }\n};","map":{"version":3,"names":["consultarFacturas","consultarFacturasConClientes","data","facturas","facturasConClientes","mostrarClientes","cargando","mensaje","mensajeColor","methods","consultarBasico","console","log","length","e","error","response","message","consultarConClientes","clientesEncontrados","filter","f","clienteCompleto","formatearGenero","genero","generos"],"sources":["C:\\Users\\mdllumiquingat\\Documents\\Programacion\\final_web\\src\\components\\ReporteFactura.vue"],"sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <h2 class=\"titulo\">Reporte de Facturas</h2>\r\n    <div class=\"consulta-section\">\r\n      <button @click=\"consultarBasico\" class=\"btn-consultar\">Reporte Básico</button>\r\n      <button @click=\"consultarConClientes\" class=\"btn-clientes\">Reporte con Datos de Clientes</button>\r\n    </div>\r\n\r\n    <!-- Tabla básica de facturas -->\r\n    <table v-if=\"facturas.length && !mostrarClientes\" class=\"tabla-reporte\">\r\n      <thead>\r\n        <tr>\r\n          <th>Número de Documento</th>\r\n          <th>Identificación del Cliente</th>\r\n          <th>Nombre del Cliente</th>\r\n          <th>Cantidad de Ítems</th>\r\n          <th>Total Impuestos</th>\r\n          <th>TOTAL</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"factura in facturas\" :key=\"factura.numeroDocumento\">\r\n          <td>{{ factura.numeroDocumento }}</td>\r\n          <td>{{ factura.identificacionCliente }}</td>\r\n          <td>{{ factura.nombreCliente }}</td>\r\n          <td>{{ factura.cantidadItems }}</td>\r\n          <td>{{ factura.totalImpuestos }}</td>\r\n          <td>{{ factura.total }}</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n\r\n    <!-- Tabla con información completa de clientes -->\r\n    <table v-if=\"facturasConClientes.length && mostrarClientes\" class=\"tabla-reporte tabla-expandida\">\r\n      <thead>\r\n        <tr>\r\n          <th>Número de Documento</th>\r\n          <th>Cliente</th>\r\n          <th>Género</th>\r\n          <th>Teléfono</th>\r\n          <th>Email</th>\r\n          <th>Dirección</th>\r\n          <th>Cantidad de Ítems</th>\r\n          <th>TOTAL</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"factura in facturasConClientes\" :key=\"factura.numeroDocumento\">\r\n          <td>{{ factura.numeroDocumento }}</td>\r\n          <td>\r\n            <div class=\"cliente-info\">\r\n              <strong>{{ factura.nombreCliente }}</strong>\r\n              <small>{{ factura.identificacionCliente }}</small>\r\n            </div>\r\n          </td>\r\n          <td>\r\n            <span class=\"genero-badge\" :class=\"factura.clienteCompleto?.genero\">\r\n              {{ formatearGenero(factura.clienteCompleto?.genero) }}\r\n            </span>\r\n          </td>\r\n          <td>{{ factura.clienteCompleto?.telefono || 'N/A' }}</td>\r\n          <td>{{ factura.clienteCompleto?.email || 'N/A' }}</td>\r\n          <td>{{ factura.clienteCompleto?.direccion || 'N/A' }}</td>\r\n          <td>{{ factura.cantidadItems }}</td>\r\n          <td><strong>${{ factura.total?.toFixed(2) || '0.00' }}</strong></td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n\r\n    <div v-if=\"cargando\" class=\"mensaje\">Cargando información de clientes...</div>\r\n    <div v-if=\"mensaje\" class=\"mensaje\" :style=\"{color: mensajeColor}\">{{ mensaje }}</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n// Importa aquí tu función para consultar facturas\r\nimport { consultarFacturas, consultarFacturasConClientes } from '../Clients/ReporteFacturaClient';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      facturas: [],\r\n      facturasConClientes: [],\r\n      mostrarClientes: false,\r\n      cargando: false,\r\n      mensaje: '',\r\n      mensajeColor: 'green',\r\n    };\r\n  },\r\n  methods: {\r\n    async consultarBasico() {\r\n      try {\r\n        console.log('Iniciando consulta básica de facturas...');\r\n        this.cargando = true;\r\n        this.mostrarClientes = false;\r\n        this.mensaje = 'Cargando facturas...';\r\n        this.mensajeColor = 'blue';\r\n        \r\n        const data = await consultarFacturas();\r\n        console.log('Datos recibidos en consultarBasico:', data);\r\n        \r\n        this.facturas = data || [];\r\n        this.facturasConClientes = [];\r\n        \r\n        if (this.facturas.length === 0) {\r\n          this.mensaje = 'No se encontraron facturas';\r\n          this.mensajeColor = 'orange';\r\n        } else {\r\n          this.mensaje = `Se encontraron ${this.facturas.length} facturas`;\r\n          this.mensajeColor = 'green';\r\n        }\r\n      } catch (e) {\r\n        console.error('Error en consultarBasico:', e);\r\n        this.mensaje = 'Error al consultar facturas: ' + (e.response?.data?.message || e.message || 'Error desconocido');\r\n        this.mensajeColor = 'red';\r\n        this.facturas = [];\r\n      } finally {\r\n        this.cargando = false;\r\n      }\r\n    },\r\n\r\n    async consultarConClientes() {\r\n      try {\r\n        console.log('Iniciando consulta con clientes...');\r\n        this.cargando = true;\r\n        this.mostrarClientes = true;\r\n        this.mensaje = 'Cargando información de clientes...';\r\n        this.mensajeColor = 'blue';\r\n        \r\n        const data = await consultarFacturasConClientes();\r\n        console.log('Datos recibidos en consultarConClientes:', data);\r\n        \r\n        this.facturasConClientes = data || [];\r\n        this.facturas = [];\r\n        \r\n        if (this.facturasConClientes.length === 0) {\r\n          this.mensaje = 'No se encontraron facturas con datos de clientes';\r\n          this.mensajeColor = 'orange';\r\n        } else {\r\n          const clientesEncontrados = this.facturasConClientes.filter(f => f.clienteCompleto).length;\r\n          this.mensaje = `Se encontraron ${this.facturasConClientes.length} facturas (${clientesEncontrados} con datos de cliente)`;\r\n          this.mensajeColor = 'green';\r\n        }\r\n      } catch (e) {\r\n        this.mensaje = 'Error al consultar facturas con clientes: ' + (e.response?.data || e.message);\r\n        this.mensajeColor = 'red';\r\n        this.mostrarClientes = false;\r\n      } finally {\r\n        this.cargando = false;\r\n      }\r\n    },\r\n\r\n    formatearGenero(genero) {\r\n      const generos = {\r\n        'masculino': 'Masculino',\r\n        'femenino': 'Femenino',\r\n        'otro': 'Otro',\r\n        'no_especifica': 'No especifica'\r\n      };\r\n      return generos[genero] || 'N/A';\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\nbody {\r\n  font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;\r\n  background: #f6f8fa;\r\n}\r\n\r\n.container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 2rem;\r\n}\r\n\r\n.titulo {\r\n  text-align: center;\r\n  font-size: 2.2rem;\r\n  font-weight: 700;\r\n  color: #2c3e50;\r\n  margin-bottom: 2rem;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.consulta-section {\r\n  text-align: center;\r\n  margin-bottom: 2rem;\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 1rem;\r\n}\r\n\r\n.btn-consultar, .btn-clientes {\r\n  background: linear-gradient(90deg, #007bff 0%, #0056b3 100%);\r\n  color: #fff;\r\n  border: none;\r\n  border-radius: 8px;\r\n  padding: 0.7rem 1.5rem;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.07);\r\n  transition: background 0.2s, transform 0.1s;\r\n}\r\n\r\n.btn-clientes {\r\n  background: linear-gradient(90deg, #28a745 0%, #218838 100%);\r\n}\r\n\r\n.btn-consultar:hover, .btn-clientes:hover {\r\n  transform: translateY(-2px) scale(1.03);\r\n}\r\n\r\n.btn-clientes:hover {\r\n  background: linear-gradient(90deg, #218838 0%, #28a745 100%);\r\n}\r\n\r\n.tabla-reporte {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 24px rgba(44,62,80,0.08);\r\n  overflow: hidden;\r\n  margin: 0 auto 2rem auto;\r\n}\r\n\r\n.tabla-reporte th, .tabla-reporte td {\r\n  padding: 1rem 1.2rem;\r\n  text-align: center;\r\n  border: none;\r\n}\r\n\r\n.tabla-reporte th {\r\n  background: #007bff;\r\n  color: #fff;\r\n  font-weight: 600;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.tabla-reporte tr:nth-child(even) {\r\n  background: #f2f6fc;\r\n}\r\n\r\n.tabla-reporte tr:hover {\r\n  background: #eaf1fb;\r\n}\r\n\r\n.mensaje {\r\n  text-align: center;\r\n  font-size: 1.1rem;\r\n  font-weight: 500;\r\n  margin-top: 1.2rem;\r\n  padding: 0.7rem 1rem;\r\n  border-radius: 8px;\r\n  background: #f8f9fa;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.04);\r\n  max-width: 600px;\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n}\r\n\r\n/* Estilos para la tabla expandida */\r\n.tabla-expandida {\r\n  font-size: 0.85rem;\r\n}\r\n\r\n.tabla-expandida th {\r\n  padding: 0.8rem 0.6rem;\r\n  font-size: 0.8rem;\r\n}\r\n\r\n.tabla-expandida td {\r\n  padding: 0.8rem 0.6rem;\r\n}\r\n\r\n.cliente-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.2rem;\r\n}\r\n\r\n.cliente-info strong {\r\n  font-size: 0.9rem;\r\n  color: #2c3e50;\r\n}\r\n\r\n.cliente-info small {\r\n  font-size: 0.75rem;\r\n  color: #6c757d;\r\n}\r\n\r\n/* Badges para género */\r\n.genero-badge {\r\n  padding: 0.2rem 0.6rem;\r\n  border-radius: 12px;\r\n  font-size: 0.75rem;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  display: inline-block;\r\n}\r\n\r\n.genero-badge.masculino {\r\n  background: #e3f2fd;\r\n  color: #1976d2;\r\n}\r\n\r\n.genero-badge.femenino {\r\n  background: #fce4ec;\r\n  color: #c2185b;\r\n}\r\n\r\n.genero-badge.otro {\r\n  background: #f3e5f5;\r\n  color: #7b1fa2;\r\n}\r\n\r\n.genero-badge.no_especifica {\r\n  background: #f5f5f5;\r\n  color: #616161;\r\n}\r\n\r\n.genero-badge:not(.masculino):not(.femenino):not(.otro):not(.no_especifica) {\r\n  background: #e0e0e0;\r\n  color: #757575;\r\n}\r\n</style>"],"mappings":";;AA2EA;AACA,SAASA,iBAAiB,EAAEC,4BAA2B,QAAS,iCAAiC;AAEjG,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,mBAAmB,EAAE,EAAE;MACvBC,eAAe,EAAE,KAAK;MACtBC,QAAQ,EAAE,KAAK;MACfC,OAAO,EAAE,EAAE;MACXC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,eAAeA,CAAA,EAAG;MACtB,IAAI;QACFC,OAAO,CAACC,GAAG,CAAC,0CAA0C,CAAC;QACvD,IAAI,CAACN,QAAO,GAAI,IAAI;QACpB,IAAI,CAACD,eAAc,GAAI,KAAK;QAC5B,IAAI,CAACE,OAAM,GAAI,sBAAsB;QACrC,IAAI,CAACC,YAAW,GAAI,MAAM;QAE1B,MAAMN,IAAG,GAAI,MAAMF,iBAAiB,CAAC,CAAC;QACtCW,OAAO,CAACC,GAAG,CAAC,qCAAqC,EAAEV,IAAI,CAAC;QAExD,IAAI,CAACC,QAAO,GAAID,IAAG,IAAK,EAAE;QAC1B,IAAI,CAACE,mBAAkB,GAAI,EAAE;QAE7B,IAAI,IAAI,CAACD,QAAQ,CAACU,MAAK,KAAM,CAAC,EAAE;UAC9B,IAAI,CAACN,OAAM,GAAI,4BAA4B;UAC3C,IAAI,CAACC,YAAW,GAAI,QAAQ;QAC9B,OAAO;UACL,IAAI,CAACD,OAAM,GAAI,kBAAkB,IAAI,CAACJ,QAAQ,CAACU,MAAM,WAAW;UAChE,IAAI,CAACL,YAAW,GAAI,OAAO;QAC7B;MACF,EAAE,OAAOM,CA